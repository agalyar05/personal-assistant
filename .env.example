# --- Required ---
GROQ_API_KEY=
PHONE_EMAIL=2486675992@tmomail.net
CRON_SECRET=pick-a-long-random-string

# Google OAuth (from scripts/google-oauth.mjs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional but recommended — GV relay once you know it
# GOOGLE_VOICE_REPLY_EMAIL=yourgv.yourphone@txt.voice.google.com

# Defaults
TIMEZONE=America/Detroit
WEATHER_CITY=Detroit
GV_SEND_DELAY_MS=1500
GMAIL_LOOKBACK_DAYS=7

# --- Optional Supabase (leave empty to use local data/store.json) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
